# Copy these keys into Coolify → Environment for each OpenAlgo instance.
# One Coolify application = one broker + one user. Repeat for each broker.
#
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"

# --- Instance identity (unique per Coolify app) ---
OPENALGO_INSTANCE_NAME=kotak-user1

# --- Public URLs (HTTPS; never 127.0.0.1 on Coolify) ---
HOST_SERVER=https://kotak.example.com
REDIRECT_URL=https://kotak.example.com/kotak/callback
WEBSOCKET_URL=wss://kotak.example.com/ws
CORS_ALLOWED_ORIGINS=https://kotak.example.com

# --- Broker (single broker per instance) ---
VALID_BROKERS=kotak
BROKER_API_KEY=
BROKER_API_SECRET=
# XTS brokers only:
BROKER_API_KEY_MARKET=
BROKER_API_SECRET_MARKET=

# --- Security (unique per instance; never reuse across Coolify apps) ---
APP_KEY=
API_KEY_PEPPER=

# --- Cookies (optional; auto-derived from OPENALGO_INSTANCE_NAME if omitted) ---
# SESSION_COOKIE_NAME=session_kotak_user1
# CSRF_COOKIE_NAME=csrf_kotak_user1

# --- Proxy (Coolify/Traefik in front) ---
TRUST_PROXY_HEADERS=TRUE

# --- Flask / runtime ---
FLASK_ENV=production
FLASK_DEBUG=False

# --- WebSocket (internal port stays 8765; proxy exposes /ws) ---
WEBSOCKET_PORT=8765

# --- Optional: Remote MCP ---
# MCP_HTTP_ENABLED=True
# MCP_PUBLIC_URL=https://kotak.example.com

# --- Optional overrides (defaults applied by start.sh if unset) ---
# LOG_LEVEL=INFO
# SESSION_EXPIRY_TIME=03:00
# DISABLE_SESSION_EXPIRY=false
# STRATEGY_MEMORY_LIMIT_MB=1024
# SHM_SIZE=512m
