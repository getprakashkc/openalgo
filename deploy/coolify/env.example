# =============================================================================
# Coolify → Environment — copy every REQUIRED line into your app settings
# Generate secrets:  py -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================
#
# NEVER paste APP_KEY or API_KEY_PEPPER from .sample.env or your PC .env file.
# Those public/leaked values block startup (see start.sh preflight).

# --- REQUIRED: instance label ---
OPENALGO_INSTANCE_NAME=sharada-kotak

# --- REQUIRED: public HTTPS URLs (match your Coolify domain) ---
HOST_SERVER=https://openalgo-sharada.hi1.agni.cash
REDIRECT_URL=https://openalgo-sharada.hi1.agni.cash/kotak/callback
WEBSOCKET_URL=wss://openalgo-sharada.hi1.agni.cash/ws
CORS_ALLOWED_ORIGINS=https://openalgo-sharada.hi1.agni.cash

# --- REQUIRED: one broker ---
VALID_BROKERS=kotak
BROKER_API_KEY=your_kotak_consumer_key
BROKER_API_SECRET=your_kotak_consumer_secret

# --- REQUIRED: new random 64-char hex (two different values) ---
APP_KEY=generate_a_new_64_char_hex_string
API_KEY_PEPPER=generate_another_new_64_char_hex_string

# --- REQUIRED for Coolify / Traefik ---
TRUST_PROXY_HEADERS=TRUE
FLASK_ENV=production
FLASK_DEBUG=False

# --- XTS brokers only (leave empty for Kotak, Zerodha, Dhan, etc.) ---
BROKER_API_KEY_MARKET=
BROKER_API_SECRET_MARKET=

# --- Optional ---
# SESSION_COOKIE_NAME=
# CSRF_COOKIE_NAME=
# MCP_HTTP_ENABLED=False
# MCP_PUBLIC_URL=
# LOG_LEVEL=INFO
# SHM_SIZE=512m
